# Copy this file to terraform.tfvars and edit the values.
# Do not commit terraform.tfvars.

name        = "yz-vps"
server_type = "cx22" # 2 vCPU, 4 GB
location    = "fsn1"
image       = "ubuntu-24.04"

# Hetzner's own backups cost extra. Restic already covers this stack.
enable_backups = false

ssh_public_key_path = "~/.ssh/id_ed25519.pub"
deploy_user         = "deploy"
ssh_port            = 22

# Bootstrap safety net. Set this to your current public IP/32 for the first
# boot, verify Tailscale works, then set it back to [] and apply again.
ssh_source_cidrs = []

# Prefer exporting the Tailscale auth key instead of writing it here:
#   export TF_VAR_tailscale_authkey='tskey-auth-...'
# tailscale_authkey = "tskey-auth-replace-me"

tailscale_hostname = "yz-vps"
tailscale_ssh      = false
allow_tailscale_udp = true

swap_size_mb = 2048
timezone     = "UTC"

labels = {
  environment = "production"
}
