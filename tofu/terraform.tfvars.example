name        = "yz-vps"
server_type = "cx23"
location    = "nbg1"
image       = "ubuntu-24.04"

enable_backups = false

ssh_public_key_path = "~/.ssh/id_ed25519.pub"
deploy_user         = "deploy"
ssh_port            = 22

ssh_source_cidrs = []

# tailscale_authkey = "tskey-auth-replace-me"
# tailscale_hostname = "yz-vps"

tailscale_ssh       = false
allow_tailscale_udp = true

swap_size_mb = 2048
timezone     = "UTC"

labels = {
  environment = "production"
}

dns_zone      = "yzlaboratory.dev"
app_subdomain = "auth"

ses_dkim_tokens = []
