# Copy to .env on the server at /srv/apps/example/.env.
# Compose reads this file for both variable substitution and the container env.
APP_DOMAIN=example.example.com
APP_PORT=3000

# Add application secrets below. Keep this file out of git.
# DATABASE_URL=postgres://example:replace-me@postgres:5432/example
# SESSION_SECRET=replace-with-a-long-random-value
