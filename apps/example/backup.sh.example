#!/usr/bin/env bash
# Optional app backup hook.
#
# /srv/ops/restic/backup.sh runs every executable /srv/apps/*/backup.sh before
# the restic snapshot. Write consistent dumps into ./backups so restic picks
# them up. Keep the output small; it is uploaded daily.
set -euo pipefail
cd "$(dirname "$0")"
mkdir -p backups

# Example for a Compose Postgres service named "postgres":
# docker compose exec -T postgres pg_dumpall -U postgres > backups/db.sql
#
# Example for SQLite + Litestream: Litestream already replicates continuously,
# so this hook may only need to copy the database file:
# cp data/app.db backups/app.db

# Keep the local dump directory from growing without bound.
find backups -type f -mtime +7 -delete
