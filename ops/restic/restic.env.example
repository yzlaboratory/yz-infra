# Copy to /etc/yz-infra/restic.env with mode 0600.
# Never commit the filled-in file.

# Cloudflare R2 over the S3-compatible API.
# The bucket must exist and the API token must allow Object Read & Write.
RESTIC_REPOSITORY="s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>/yz-infra"

# Restic repository encryption password. Losing this makes backups unreadable.
RESTIC_PASSWORD="replace-with-a-long-random-password"

# R2 S3 credentials. Create an R2 API token scoped to the bucket.
AWS_ACCESS_KEY_ID="replace-me"
AWS_SECRET_ACCESS_KEY="replace-me"
AWS_DEFAULT_REGION="auto"

# Optional Healthchecks.io ping URL. A failed run pings <url>/fail.
HEALTHCHECK_URL=""

# Set to 1 to run restic check --read-data-subset=5% after each backup.
RESTIC_CHECK="0"
